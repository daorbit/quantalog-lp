{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "quantalog-lp.vercel.app"
        }
      ],
      "destination": "https://quantalog.daorbit.in/:path*",
      "permanent": true
    },
    {
      "source": "/vs/:path*",
      "destination": "/compare/:path*",
      "permanent": true
    },
    {
      "source": "/vs",
      "destination": "/compare",
      "permanent": true
    },
    {
      "source": "/docs/analytics",
      "destination": "/docs/overview",
      "permanent": true
    },
    {
      "source": "/docs/seo-audits",
      "destination": "/docs/seo",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/plans",
      "permanent": true
    },
    {
      "source": "/features",
      "destination": "/analytics",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "https://studio-quantalog.daorbit.in/login",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "https://studio-quantalog.daorbit.in/signup",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|avif|svg|ico|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
