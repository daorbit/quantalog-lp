# The CMS the blog reads from. Both endpoints it uses are public, so there is
# no key here — these are safe to expose to the browser.
#
# Point this at the API, not at the CMS web app: the app answers any unknown
# path with its own index.html, which is not JSON.
NEXT_PUBLIC_CMS_API_URL=https://da-cms.vercel.app/api
NEXT_PUBLIC_CMS_WORKSPACE_ID=6a9cfdb839090e083196fcaa
